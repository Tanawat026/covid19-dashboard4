<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>COVID-19 Thailand Data Dashboard</title>

    <!-- Bootstrap 5 CSS CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Leaflet CSS CDN -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <!-- FontAwesome Icons CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        body {
            background-color: #f4f6f9;
            font-family: 'Sarabun', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }
        .header-card {
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            color: white;
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        }
        .profile-img {
            width: 100px;
            height: 100px;
            object-fit: cover;
            border-radius: 50%;
            border: 3px solid #ffffff;
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
        }
        .card-custom {
            border: none;
            border-radius: 14px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.05);
            background-color: #ffffff;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .card-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 16px rgba(0,0,0,0.08);
        }
        .map-container {
            height: 480px;
            width: 100%;
            border-radius: 12px;
            z-index: 1;
        }
        .chart-container {
            position: relative;
            height: 320px;
            width: 100%;
        }
        .stat-value {
            font-size: 1.8rem;
            font-weight: 700;
        }
        .legend {
            padding: 8px 12px;
            font-size: 12px;
            background: rgba(255, 255, 255, 0.95);
            box-shadow: 0 0 10px rgba(0,0,0,0.15);
            border-radius: 6px;
            line-height: 18px;
            color: #333;
        }
        .legend i {
            width: 16px;
            height: 16px;
            float: left;
            margin-right: 8px;
            opacity: 0.85;
            border-radius: 3px;
        }
    </style>
</head>
<body>

<div class="container my-4">

    <!-- Header & Profile Component -->
    <div class="card header-card p-4 mb-4">
        <div class="row align-items-center">
            <div class="col-md-auto text-center mb-3 mb-md-0">
                <!-- Profile Image URL -->
                <img src="https://avatars.githubusercontent.com/u/335393951?s=400&u=f7b18c990f2e1c1eb4ba06edd4bc851d78acc738&v=4" alt="Profile" class="profile-img">
            </div>
            <div class="col-md">
                <h2 class="fw-bold mb-1"><i class="fa-solid fa-shield-virus me-2"></i>COVID-19 Thailand Data Dashboard</h2>
                <p class="mb-2 text-white-50">ระบบรายงานสถิติและวิเคราะห์สถานการณ์การแพร่ระบาดเชื้อโควิด-19</p>
                <div class="d-flex flex-wrap gap-2">
                    <span class="badge bg-light text-dark px-3 py-2"><i class="fa-solid fa-user-graduate me-1"></i>นักศึกษา: นายธณวัตร นามเขต</span>
                    <span class="badge bg-warning text-dark px-3 py-2"><i class="fa-solid fa-database me-1"></i>Data Source: final69_15.csv</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Interactive Filters Component -->
    <div class="card card-custom p-3 mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold m-0"><i class="fa-solid fa-filter text-primary me-2"></i>ตัวกรองข้อมูล (Dynamic Filters)</h5>
            <button id="resetFilterBtn" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-rotate-left me-1"></i>รีเซ็ตตัวกรอง</button>
        </div>
        <div class="row g-3">
            <div class="col-md-3">
                <label for="filterProvince" class="form-label fw-semibold">จังหวัด (Province)</label>
                <select id="filterProvince" class="form-select">
                    <option value="">-- แสดงทุกจังหวัด --</option>
                </select>
            </div>
            <div class="col-md-3">
                <label for="filterSex" class="form-label fw-semibold">เพศ (Sex)</label>
                <select id="filterSex" class="form-select">
                    <option value="">-- ทุกเพศ --</option>
                    <option value="ชาย">ชาย</option>
                    <option value="หญิง">หญิง</option>
                </select>
            </div>
            <div class="col-md-3">
                <label for="filterStartDate" class="form-label fw-semibold">วันที่เริ่มต้น (Announce Date)</label>
                <input type="date" id="filterStartDate" class="form-control">
            </div>
            <div class="col-md-3">
                <label for="filterEndDate" class="form-label fw-semibold">วันที่สิ้นสุด (Announce Date)</label>
                <input type="date" id="filterEndDate" class="form-control">
            </div>
        </div>
    </div>

    <!-- Key Metrics Cards -->
    <div class="row g-3 mb-4 text-center">
        <div class="col-md-3">
            <div class="card card-custom p-3 border-start border-primary border-4">
                <div class="text-muted small fw-bold text-uppercase">ผู้ติดเชื้อทั้งหมด</div>
                <div id="totalCases" class="stat-value text-primary mt-1">0</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card card-custom p-3 border-start border-info border-4">
                <div class="text-muted small fw-bold text-uppercase">เพศชาย</div>
                <div id="maleCases" class="stat-value text-info mt-1">0</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card card-custom p-3 border-start border-danger border-4">
                <div class="text-muted small fw-bold text-uppercase">เพศหญิง</div>
                <div id="femaleCases" class="stat-value text-danger mt-1">0</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card card-custom p-3 border-start border-warning border-4">
                <div class="text-muted small fw-bold text-uppercase">อายุเฉลี่ย (ปี)</div>
                <div id="avgAge" class="stat-value text-warning mt-1">0</div>
            </div>
        </div>
    </div>

    <!-- Maps Section -->
    <div class="row g-3 mb-4">
        <div class="col-lg-6">
            <div class="card card-custom p-3 h-100">
                <h5 class="fw-bold mb-3"><i class="fa-solid fa-location-dot text-danger me-2"></i>แผนที่ที่ 1: Spot Map (กระจายตัวระดับอำเภอ/สถานที่)</h5>
                <div id="spotMap" class="map-container"></div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card card-custom p-3 h-100">
                <h5 class="fw-bold mb-3"><i class="fa-solid fa-map text-success me-2"></i>แผนที่ที่ 2: Choropleth Map (ความหนาแน่นระดับจังหวัด)</h5>
                <div id="choroplethMap" class="map-container"></div>
            </div>
        </div>
    </div>

    <!-- Epidemic Curve Chart -->
    <div class="row g-3 mb-4">
        <div class="col-12">
            <div class="card card-custom p-3">
                <h5 class="fw-bold mb-3"><i class="fa-solid fa-chart-line text-primary me-2"></i>Epidemic Curve (แนวโน้มจำนวนผู้ติดเชื้อตามเวลา)</h5>
                <div class="chart-container" style="height: 360px;">
                    <canvas id="epiCurveChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- General Charts Section -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card card-custom p-3">
                <h6 class="fw-bold mb-3"><i class="fa-solid fa-chart-pie me-2 text-info"></i>สัดส่วนเพศผู้ติดเชื้อ</h6>
                <div class="chart-container">
                    <canvas id="sexChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-custom p-3">
                <h6 class="fw-bold mb-3"><i class="fa-solid fa-chart-column me-2 text-warning"></i>การกระจายตัวตามกลุ่มอายุ</h6>
                <div class="chart-container">
                    <canvas id="ageChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-custom p-3">
                <h6 class="fw-bold mb-3"><i class="fa-solid fa-list-ol me-2 text-success"></i>10 อันดับจังหวัดติดเชื้อสูงสุด</h6>
                <div class="chart-container">
                    <canvas id="provinceChart"></canvas>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- PapaParse CDN -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.4.1/papaparse.min.js"></script>
<!-- Leaflet JS CDN -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<!-- Chart.js CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    // URL สำหรับดึงไฟล์ CSV ออนไลน์ หรือไฟล์ในโฟลเดอร์เดียวกัน
    const CSV_URL = 'final69_15.csv';

    // พิกัดละติจูด-ลองจิจูดของจังหวัดต่างๆ ในประเทศไทย
    const PROVINCE_COORDS = {
        "กรุงเทพมหานคร": [13.7563, 100.5018], "สมุทรปราการ": [13.5991, 100.5998],
        "นนทบุรี": [13.8591, 100.5217], "ปทุมธานี": [14.0208, 100.5250],
        "ชลบุรี": [13.3611, 100.9847], "เชียงใหม่": [18.7883, 98.9853],
        "นครราชสีมา": [14.9799, 102.0978], "ขอนแก่น": [16.4322, 102.8236],
        "สงขลา": [7.1988, 100.5951], "ภูเก็ต": [7.8804, 98.3923],
        "มหาสารคาม": [16.1851, 103.3007], "ศรีสะเกษ": [15.1186, 104.3220],
        "อุบลราชธานี": [15.2448, 104.8473], "อุดรธานี": [17.4138, 102.7872],
        "ระยอง": [12.6814, 101.2816], "สุราษฎร์ธานี": [9.1382, 99.3217],
        "เชียงราย": [19.9076, 99.8325], "ยโสธร": [15.7926, 104.1453],
        "พังงา": [8.4501, 98.5255], "เลย": [17.4860, 101.7223],
        "ฉะเชิงเทรา": [13.6904, 101.0779], "พระนครศรีอยุธยา": [14.3532, 100.5684],
        "สมุทรสาคร": [13.5475, 100.2744], "กาญจนบุรี": [14.0227, 99.5328],
        "ร้อยเอ็ด": [16.0538, 103.6520], "หนองคาย": [17.8783, 102.7421],
        "ลพบุรี": [14.7995, 100.6534], "หนองบัวลำภู": [17.2038, 102.4402],
        "กาฬสินธุ์": [16.4353, 103.5074], "ราชบุรี": [13.5373, 99.8164],
        "จันทบุรี": [12.6114, 102.1039], "อำนาจเจริญ": [15.8582, 104.6258],
        "บึงกาฬ": [18.3614, 103.6464], "สกลนคร": [17.1612, 104.1472],
        "สระบุรี": [14.5289, 100.9108], "พิษณุโลก": [16.8211, 100.2659],
        "นครนายก": [14.2069, 101.2131], "นครสวรรค์": [15.7029, 100.1372],
        "เพชรบูรณ์": [16.4190, 101.1565], "ชัยนาท": [15.1852, 100.1251],
        "พัทลุง": [7.6167, 100.0740], "นครปฐม": [13.8196, 100.0622],
        "สระแก้ว": [13.8240, 102.0646], "สุโขทัย": [17.0078, 99.8234],
        "ปราจีนบุรี": [14.0509, 101.3717], "สุพรรณบุรี": [14.4745, 100.1177],
        "อ่างทอง": [14.5896, 100.4550], "ชุมพร": [10.4930, 99.1800],
        "ตาก": [16.8839, 99.1258], "อุตรดิตถ์": [17.6201, 100.0993],
        "มุกดาหาร": [16.5453, 104.7238], "นครพนม": [17.3920, 104.7696],
        "ตรัง": [7.5563, 99.6114], "ปัตตานี": [6.8677, 101.2502],
        "สตูล": [6.6238, 100.0674], "พะเยา": [19.1657, 99.9018],
        "กระบี่": [8.0863, 98.9063], "อุทัยธานี": [15.3835, 100.0247],
        "พิจิตร": [16.4421, 100.3486], "กำแพงเพชร": [16.4828, 99.5227],
        "สิงห์บุรี": [14.8878, 100.3967], "นครศรีธรรมราช": [8.4304, 99.9631],
        "ประจวบคีรีขันธ์": [11.8124, 99.7972], "ตราด": [12.2428, 102.5165],
        "เพชรบุรี": [13.1069, 99.9447], "แม่ฮ่องสอน": [19.3021, 97.9654],
        "ยะลา": [6.5411, 101.2804], "ระนอง": [9.9658, 98.6348],
        "ลำปาง": [18.2888, 99.4923], "แพร่": [18.1446, 100.1403],
        "นราธิวาส": [6.4255, 101.8253], "สมุทรสงคราม": [13.4098, 100.0023],
        "น่าน": [18.7838, 100.7782], "ลำพูน": [18.5745, 99.0087],
        "ชัยภูมิ": [15.8068, 102.0315], "สุรินทร์": [14.8824, 103.4936],
        "บุรีรัมย์": [14.9930, 103.1029]
    };

    let rawData = [];
    let spotMap, choroplethMap;
    let spotMarkersLayer = L.layerGroup();
    let choroplethLayer = L.layerGroup();

    // Chart instances
    let epiCurveChart, sexChart, ageChart, provinceChart;

    document.addEventListener("DOMContentLoaded", function() {
        initMaps();
        loadCSVData();

        document.getElementById('filterProvince').addEventListener('change', updateDashboard);
        document.getElementById('filterSex').addEventListener('change', updateDashboard);
        document.getElementById('filterStartDate').addEventListener('change', updateDashboard);
        document.getElementById('filterEndDate').addEventListener('change', updateDashboard);
        document.getElementById('resetFilterBtn').addEventListener('click', resetFilters);
    });

    function initMaps() {
        // Map 1: Spot Map
        spotMap = L.map('spotMap').setView([13.7367, 100.5231], 6);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(spotMap);
        spotMarkersLayer.addTo(spotMap);

        // Map 2: Choropleth Map
        choroplethMap = L.map('choroplethMap').setView([13.7367, 100.5231], 6);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(choroplethMap);
        choroplethLayer.addTo(choroplethMap);

        // Add Legend to Choropleth Map
        const legend = L.control({position: 'bottomright'});
        legend.onAdd = function () {
            const div = L.DomUtil.create('div', 'legend');
            const grades = [0, 50, 100, 250, 500, 1000];
            div.innerHTML = '<strong>จำนวนผู้ติดเชื้อ</strong><br>';
            for (let i = 0; i < grades.length; i++) {
                div.innerHTML +=
                    '<i style="background:' + getColor(grades[i] + 1) + '"></i> ' +
                    grades[i] + (grades[i + 1] ? '&ndash;' + grades[i + 1] + '<br>' : '+');
            }
            return div;
        };
        legend.addTo(choroplethMap);
    }

    function loadCSVData() {
        // ดึงไฟล์ CSV ผ่าน PapaParse
        Papa.parse(CSV_URL, {
            download: true,
            header: true,
            skipEmptyLines: true,
            complete: function(results) {
                rawData = results.data;
                populateProvinceDropdown(rawData);
                updateDashboard();
            },
            error: function(err) {
                console.error("Error reading CSV file:", err);
            }
        });
    }

    function populateProvinceDropdown(data) {
        const provinces = new Set();
        data.forEach(d => {
            const p = (d.province_of_isolation || d.province_of_onset || '').trim();
            if (p && p !== 'Cambodia' && !p.includes('\u200b')) {
                provinces.add(p);
            }
        });
        
        const select = document.getElementById('filterProvince');
        Array.from(provinces).sort().forEach(p => {
            const opt = document.createElement('option');
            opt.value = p;
            opt.textContent = p;
            select.appendChild(opt);
        });
    }

    function parseDate(dateStr) {
        if (!dateStr) return null;
        const parts = dateStr.trim().split('/');
        if (parts.length === 3) {
            // Format: DD/MM/YYYY
            return new Date(parts[2], parts[1] - 1, parts[0]);
        }
        return null;
    }

    function getFilteredData() {
        const selectedProv = document.getElementById('filterProvince').value;
        const selectedSex = document.getElementById('filterSex').value;
        const startDateStr = document.getElementById('filterStartDate').value;
        const endDateStr = document.getElementById('filterEndDate').value;

        const startDate = startDateStr ? new Date(startDateStr) : null;
        const endDate = endDateStr ? new Date(endDateStr) : null;

        return rawData.filter(d => {
            const prov = (d.province_of_isolation || d.province_of_onset || '').trim();
            if (selectedProv && prov !== selectedProv) return false;
            if (selectedSex && d.sex !== selectedSex) return false;

            const recordDate = parseDate(d.announce_date || d['Notified date']);
            if (startDate && recordDate && recordDate < startDate) return false;
            if (endDate && recordDate && recordDate > endDate) return false;

            return true;
        });
    }

    function updateDashboard() {
        const filteredData = getFilteredData();
        updateMetrics(filteredData);
        renderSpotMap(filteredData);
        renderChoroplethMap(filteredData);
        renderCharts(filteredData);
    }

    function resetFilters() {
        document.getElementById('filterProvince').value = '';
        document.getElementById('filterSex').value = '';
        document.getElementById('filterStartDate').value = '';
        document.getElementById('filterEndDate').value = '';
        updateDashboard();
    }

    function updateMetrics(data) {
        document.getElementById('totalCases').textContent = data.length.toLocaleString();

        const male = data.filter(d => d.sex === 'ชาย').length;
        const female = data.filter(d => d.sex === 'หญิง').length;
        document.getElementById('maleCases').textContent = male.toLocaleString();
        document.getElementById('femaleCases').textContent = female.toLocaleString();

        const ages = data.map(d => parseFloat(d.age)).filter(a => !isNaN(a) && a > 0);
        const avgAge = ages.length > 0 ? (ages.reduce((a, b) => a + b, 0) / ages.length).toFixed(1) : 0;
        document.getElementById('avgAge').textContent = avgAge;
    }

    function renderSpotMap(data) {
        spotMarkersLayer.clearLayers();

        // สุ่มแสดงตัวอย่างตำแหน่งหมุดเพื่อประสิทธิภาพกรณีข้อมูลจำนวนมาก
        const sampleData = data.length > 2000 ? data.slice(0, 2000) : data;

        sampleData.forEach(d => {
            const prov = (d.province_of_isolation || d.province_of_onset || '').trim();
            const district = d.district_of_onset || 'ไม่ระบุ';
            
            if (prov && PROVINCE_COORDS[prov]) {
                const baseCoord = PROVINCE_COORDS[prov];
                // กระจายหมุดพิกัดให้อยู่ในรัศมีอำเภอ/พื้นที่จริง
                const lat = baseCoord[0] + (Math.random() - 0.5) * 0.08;
                const lng = baseCoord[1] + (Math.random() - 0.5) * 0.08;

                const marker = L.circleMarker([lat, lng], {
                    radius: 5,
                    fillColor: "#dc3545",
                    color: "#ffffff",
                    weight: 1,
                    opacity: 1,
                    fillOpacity: 0.75
                });

                marker.bindPopup(`
                    <div style="font-family: Sarabun, sans-serif;">
                        <h6 class="fw-bold mb-1">เคส No. ${d['No.'] || '-'}</h6>
                        <hr class="my-1">
                        <b>สถานที่/อำเภอ:</b> ${district}<br>
                        <b>จังหวัด:</b> ${prov}<br>
                        <b>เพศ:</b> ${d.sex || '-'} | <b>อายุ:</b> ${d.age || '-'} ${d.Unit || ''}<br>
                        <b>ปัจจัยเสี่ยง:</b> ${d.risk || '-'}
                    </div>
                `);
                spotMarkersLayer.addLayer(marker);
            }
        });
    }

    function getColor(d) {
        return d > 1000 ? '#800026' :
               d > 500  ? '#BD0026' :
               d > 250  ? '#E31A1C' :
               d > 100  ? '#FC4E2A' :
               d > 50   ? '#FD8D3C' :
               d > 0    ? '#FEB24C' :
                          '#FFEDA0';
    }

    function renderChoroplethMap(data) {
        choroplethLayer.clearLayers();

        const provCounts = {};
        data.forEach(d => {
            const prov = (d.province_of_isolation || d.province_of_onset || '').trim();
            if (prov) {
                provCounts[prov] = (provCounts[prov] || 0) + 1;
            }
        });

        Object.keys(provCounts).forEach(prov => {
            if (PROVINCE_COORDS[prov]) {
                const count = provCounts[prov];
                const coord = PROVINCE_COORDS[prov];

                const circle = L.circle(coord, {
                    color: getColor(count),
                    fillColor: getColor(count),
                    fillOpacity: 0.65,
                    radius: Math.min(15000 + (count * 40), 75000)
                });

                circle.bindPopup(`
                    <div style="font-family: Sarabun, sans-serif; text-align: center;">
                        <h6 class="fw-bold mb-1">${prov}</h6>
                        <span class="badge bg-danger fs-6">${count.toLocaleString()} ราย</span>
                    </div>
                `);
                choroplethLayer.addLayer(circle);
            }
        });
    }

    function renderCharts(data) {
        // 1. Epidemic Curve Line Chart
        const dateCounts = {};
        data.forEach(d => {
            const dateStr = (d.announce_date || d['Notified date'] || '').trim();
            if (dateStr) {
                dateCounts[dateStr] = (dateCounts[dateStr] || 0) + 1;
            }
        });

        const sortedDates = Object.keys(dateCounts).sort((a, b) => {
            const da = parseDate(a);
            const db = parseDate(b);
            return (da && db) ? da - db : 0;
        });

        const epiLabels = sortedDates;
        const epiValues = sortedDates.map(d => dateCounts[d]);

        if (epiCurveChart) epiCurveChart.destroy();
        epiCurveChart = new Chart(document.getElementById('epiCurveChart'), {
            type: 'line',
            data: {
                labels: epiLabels,
                datasets: [{
                    label: 'จำนวนผู้ติดเชื้อประจำวัน (ราย)',
                    data: epiValues,
                    borderColor: '#0d6efd',
                    backgroundColor: 'rgba(13, 110, 253, 0.12)',
                    fill: true,
                    tension: 0.3,
                    pointRadius: 4,
                    pointHoverRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: true } },
                scales: {
                    x: { title: { display: true, text: 'วันที่ประกาศ (Announce Date)' } },
                    y: { title: { display: true, text: 'จำนวนผู้ติดเชื้อ (คน)' }, beginAtZero: true }
                }
            }
        });

        // 2. Sex Doughnut Chart
        const sexCounts = { 'ชาย': 0, 'หญิง': 0, 'ไม่ระบุ': 0 };
        data.forEach(d => {
            if (d.sex === 'ชาย') sexCounts['ชาย']++;
            else if (d.sex === 'หญิง') sexCounts['หญิง']++;
            else sexCounts['ไม่ระบุ']++;
        });

        if (sexChart) sexChart.destroy();
        sexChart = new Chart(document.getElementById('sexChart'), {
            type: 'doughnut',
            data: {
                labels: ['ชาย', 'หญิง', 'ไม่ระบุ'],
                datasets: [{
                    data: [sexCounts['ชาย'], sexCounts['หญิง'], sexCounts['ไม่ระบุ']],
                    backgroundColor: ['#0dcaf0', '#dc3545', '#adb5bd']
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { position: 'bottom' } }
            }
        });

        // 3. Age Bar Chart
        const ageGroups = { '0-15 ปี': 0, '16-30 ปี': 0, '31-50 ปี': 0, '51-70 ปี': 0, '71+ ปี': 0, 'ไม่ระบุ': 0 };
        data.forEach(d => {
            const age = parseFloat(d.age);
            if (isNaN(age) || age <= 0) {
                ageGroups['ไม่ระบุ']++;
            } else if (age <= 15) ageGroups['0-15 ปี']++;
            else if (age <= 30) ageGroups['16-30 ปี']++;
            else if (age <= 50) ageGroups['31-50 ปี']++;
            else if (age <= 70) ageGroups['51-70 ปี']++;
            else ageGroups['71+ ปี']++;
        });

        if (ageChart) ageChart.destroy();
        ageChart = new Chart(document.getElementById('ageChart'), {
            type: 'bar',
            data: {
                labels: Object.keys(ageGroups),
                datasets: [{
                    label: 'จำนวน (ราย)',
                    data: Object.values(ageGroups),
                    backgroundColor: '#ffc107'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true } }
            }
        });

        // 4. Top 10 Provinces Bar Chart
        const provCounts = {};
        data.forEach(d => {
            const prov = (d.province_of_isolation || d.province_of_onset || '').trim();
            if (prov && prov !== 'Cambodia' && !prov.includes('\u200b')) {
                provCounts[prov] = (provCounts[prov] || 0) + 1;
            }
        });

        const sortedProvs = Object.entries(provCounts)
            .sort((a, b) => b[1] - a[1])
            .slice(0, 10);

        if (provinceChart) provinceChart.destroy();
        provinceChart = new Chart(document.getElementById('provinceChart'), {
            type: 'bar',
            data: {
                labels: sortedProvs.map(item => item[0]),
                datasets: [{
                    label: 'จำนวนผู้ติดเชื้อ',
                    data: sortedProvs.map(item => item[1]),
                    backgroundColor: '#198754'
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: { x: { beginAtZero: true } }
            }
        });
    }
</script>
</body>
</html>
